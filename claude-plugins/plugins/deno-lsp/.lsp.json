{
  "deno": {
    "command": "deno",
    "args": [
      "lsp"
    ],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript",
      ".mts": "typescript",
      ".cts": "typescript"
    },
    "initializationOptions": {
      "enable": true
    }
  }
}
